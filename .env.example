# =============================================================================
# Автоматизация видеоуроков по 1С — переменные окружения
# Скопируйте в .env и заполните значения. НЕ коммитьте .env в git!
# =============================================================================

# --- Общие ---
APP_ENV=development
LOG_LEVEL=INFO
OUTPUT_DIR=./output
FIXTURES_DIR=./fixtures
ASSETS_DIR=./assets

# --- Pipeline ---
PIPELINE_VERSION=1.0.0
DEFAULT_LANGUAGE=ru

# --- Confidence routing (Timing Decision Agent) ---
CONFIDENCE_AUTO_APPROVE=0.92
CONFIDENCE_STANDARD_REVIEW=0.75
CONFIDENCE_SENIOR_REVIEW=0.60

# --- STT: primary Yandex SpeechKit, fallback OpenAI / faster-whisper ---
STT_PROVIDER=yandex
# yandex | openai | faster_whisper
STT_FALLBACK_ORDER=yandex,openai,faster_whisper

# Yandex SpeechKit STT
YANDEX_API_KEY=
# Каталог сервисного аккаунта SpeechKit (может отличаться от YANDEX_GPT_FOLDER_ID)
YANDEX_FOLDER_ID=
YANDEX_STT_MODEL=general

# OpenAI Whisper (fallback STT)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# faster-whisper (локальный fallback, без API)
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- TTS: primary Yandex SpeechKit, fallback OpenAI / ElevenLabs ---
TTS_PROVIDER=yandex
# yandex | openai | elevenlabs
TTS_FALLBACK_ORDER=yandex,openai,elevenlabs

# Yandex SpeechKit TTS
YANDEX_TTS_VOICE=alena
# alena | filipp | ermil | jane | omazh | zahar | dasha | ...
YANDEX_TTS_EMOTION=neutral
YANDEX_TTS_SPEED=1.0

# OpenAI TTS (fallback)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# ElevenLabs (fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# JSON map of selected voice IDs to display names; never put an API key here.
ELEVENLABS_VOICES={}

# --- LLM cleanup: primary Yandex GPT, fallback OpenAI ---
LLM_PROVIDER=yandex
# yandex | openai
LLM_FALLBACK_ORDER=yandex,openai

YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite

OPENAI_LLM_MODEL=gpt-4o-mini

# --- Video / FFmpeg ---
FFMPEG_PATH=
FFPROBE_PATH=
INTRO_VIDEO_PATH=./assets/intro.mp4
OUTRO_VIDEO_PATH=./assets/outro.mp4
REFERENCE_VIDEO_PATH=./fixtures/reference_final.mp4

# --- Visual Activity Agent (MVP heuristics) ---
VISUAL_FRAME_SAMPLE_FPS=2
VISUAL_STATIC_THRESHOLD=0.02
VISUAL_UI_CHANGE_THRESHOLD=0.15

# --- Human Review (простой веб-интерфейс) ---
REVIEW_MODE=ui
# ui | api | json
REVIEW_UI_URL=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000

# --- Domain glossary (термины 1С — не удалять при cleanup) ---
DOMAIN_GLOSSARY_PATH=./assets/glossary_1c.txt

# Максимальный размер загружаемого видео (200 МБ)
MAX_UPLOAD_MB=200

